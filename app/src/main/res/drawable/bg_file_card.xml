<?xml version="1.0" encoding="utf-8"?>
<!-- 文件消息卡片背景：自带圆角与描边。
     卡片自身就是消息体，外层不再套气泡背景。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
    <corners android:radius="6dp" />
</shape>
