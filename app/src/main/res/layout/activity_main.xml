<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== 顶部栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/surface"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 0000"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnDiscover"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_search"
            android:tint="@color/text_dim"
            android:contentDescription="发现频道"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnChannels"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_channels"
            android:tint="@color/text_dim"
            android:contentDescription="切换聊天室"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnConfig"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_dim"
            android:contentDescription="配置"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <!-- ===== 连接状态条 ===== -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg"
        android:text="● 未连接"
        android:textColor="@color/warn"
        android:textSize="11sp" />

    <!-- ===== 消息列表 ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- ===== 待发队列：多选项按序号依次发送 ===== -->
    <LinearLayout
        android:id="@+id/queueBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/surface"
        android:elevation="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvQueueCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="待发 0 项"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="原图"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:buttonTint="@color/primary"
                android:paddingStart="4dp" />

            <Button
                android:id="@+id/btnQueueSend"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:text="依次发送"
                android:textSize="12sp"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_send"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnQueueClear"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:text="清空"
                android:textSize="12sp"
                android:textColor="@color/text_dim"
                android:background="@drawable/bg_icon_btn"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- 队列项由代码动态填充 -->
        <LinearLayout
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp" />
    </LinearLayout>

    <!-- ===== 底部输入区 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_gallery"
            android:tint="@color/primary"
            android:contentDescription="选择图片（可多选）"
            android:scaleType="centerInside"
            android:padding="9dp" />

        <ImageButton
            android:id="@+id/btnFile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_attach_file"
            android:tint="@color/primary"
            android:contentDescription="发送文件（任意格式）"
            android:scaleType="centerInside"
            android:padding="9dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input"
            android:hint="输入消息…"
            android:textColorHint="@color/text_dim"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_send"
            android:src="@drawable/ic_send"
            android:tint="@color/text_on_primary"
            android:contentDescription="发送"
            android:scaleType="centerInside"
            android:padding="11dp" />

    </LinearLayout>

</LinearLayout>
