<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 消息行：头像 + 内容列。
         整行贴左 / 贴右由代码设置 layout_gravity；
         自己的消息额外把本行设为 RTL，让头像排到外侧（右侧）。 -->
    <LinearLayout
        android:id="@+id/row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 方形头像：边长 = 界面宽度 1/15，由代码按屏幕比例设置 -->
        <TextView
            android:id="@+id/ivAvatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textDirection="ltr"
            android:contentDescription="发送者头像" />

        <!-- 内容列：发送者 / 消息体 / 时间。
             内部强制 LTR，避免外层行的 RTL 影响文字与对齐方向。 -->
        <LinearLayout
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxWidth="280dp"
            android:orientation="vertical"
            android:layoutDirection="ltr">

            <!-- 发送者设备名 + 加密标记 -->
            <TextView
                android:id="@+id/tvSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/primary"
                android:textDirection="ltr"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 图片消息：不带气泡，尺寸由代码按横竖比例给出 -->
            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_image"
                android:clipToOutline="true"
                android:contentDescription="图片消息"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- 文本消息：紧凑气泡（内边距收紧） -->
            <TextView
                android:id="@+id/tvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/bubble_other_text"
                android:textDirection="ltr"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- 文件消息：固定尺寸卡片（宽 = 界面 1/2、高 = 1/10），卡片自带背景 -->
            <LinearLayout
                android:id="@+id/fileCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_file_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFileIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📎"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="@color/bubble_other_text"
                        android:textDirection="ltr"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textColor="@color/bubble_other_text"
                        android:textDirection="ltr"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 批量消息：连续图片自动折叠，组内纵向排列、无边框 -->
            <!-- 宽度必须固定：wrap_content 容器内放 MATCH_PARENT 子图会塌缩为 0 宽，
                 导致组内图片全部不可见。宽度由代码按界面比例设置。 -->
            <LinearLayout
                android:id="@+id/batchBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/batchGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 半透明胶囊「展开 / 收起」按钮 -->
                <TextView
                    android:id="@+id/batchToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_toggle_pill"
                    android:gravity="center"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 时间 -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:alpha="0.7"
                android:textColor="@color/text_dim"
                android:textDirection="ltr"
                android:textSize="10.5sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
